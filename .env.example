# Public site origin, used for canonical URLs, hreflang and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agentic Workspace app. When set, the hero demo submits to
# `${NEXT_PUBLIC_WORKSPACE_URL}?tool=<id>&q=<text>` and the nav CTA links here.
# Leave empty until the Workspace URL is decided (README open item #2).
NEXT_PUBLIC_WORKSPACE_URL=

# ThaiJO statistics endpoint (README open item #3). Leave empty to use the
# hardcoded October 2026 figures. Expected JSON: { journals, issues, articles, authors }.
THAIJO_STATS_URL=
